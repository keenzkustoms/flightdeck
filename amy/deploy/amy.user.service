[Unit]
Description=Amy workshop galaxy + Flightdeck tools
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/flightdeck/flightdeck/amy
ExecStartPre=/usr/bin/python3 /home/flightdeck/flightdeck/amy/build.py
ExecStart=/usr/bin/python3 /home/flightdeck/flightdeck/amy/server.py
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=AMY_BIND=127.0.0.1

[Install]
WantedBy=default.target

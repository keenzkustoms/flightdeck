ntfy:
  topic: flightdeck
  url: https://ntfy.sh

printers:
  - id: voron
    model_name: Voron
    custom_name: Voron
    icon: voron
    build_volume: { x: 350, y: 350, z: 350 }
    connection:
      type: moonraker
      host: 192.168.1.10
      port: 7125
    camera:
      type: mjpeg_direct
      stream_url: http://192.168.1.10/webcam/?action=stream
      snapshot_url: http://192.168.1.10/webcam/?action=snapshot
    temperature_presets:
      hotend:
        - { label: PLA, value: 220 }
        - { label: PETG, value: 245 }
        - { label: ASA, value: 255 }
        - { label: ABS, value: 250 }
      bed:
        - { label: PLA, value: 65 }
        - { label: PETG, value: 80 }
        - { label: ASA, value: 110 }
        - { label: ABS, value: 100 }

  - id: bambu
    model_name: X1C
    custom_name: Bambu
    icon: bambu
    build_volume: { x: 256, y: 256, z: 256 }
    connection:
      type: bambu
      host: 192.168.1.20
      access_code: CHANGE_ME
      serial: CHANGE_ME
    camera:
      type: bambu_rtsp
    temperature_presets:
      hotend:
        - { label: PLA, value: 220 }
        - { label: PETG, value: 245 }
        - { label: ASA, value: 255 }
        - { label: ABS, value: 250 }
      bed:
        - { label: PLA, value: 65 }
        - { label: PETG, value: 80 }
        - { label: ASA, value: 100 }
        - { label: ABS, value: 100 }

  # Snapmaker U1 example:
  # - id: u1
  #   model_name: Snapmaker U1
  #   custom_name: Snapmaker U1
  #   icon: generic
  #   build_volume: { x: 270, y: 270, z: 270 }
  #   connection:
  #     type: snapmaker_u1
  #     host: 192.168.1.30
  #     port: 7125
  #   camera:
  #     type: mjpeg_direct
  #     stream_url: http://192.168.1.30/webcam/stream.mjpg
  #     snapshot_url: http://192.168.1.30/webcam/snapshot.jpg
  #     rotation: 0            # any camera type: 0, 90, 180 or 270 (camera mounted sideways)

  # Snapshot-only camera (e.g. FLSUN S1 / other Klipper printers whose MJPEG stream is unreliable).
  # Flightdeck polls the snapshot and serves it as a stream: active_fps while printing, idle_fps otherwise.
  # - id: flsuns1
  #   model_name: FLSUN S1
  #   custom_name: FLSUN S1
  #   icon: generic
  #   build_volume: { x: 320, y: 320, z: 430 }
  #   connection:
  #     type: moonraker
  #     host: 192.168.1.40
  #     port: 7125
  #   camera:
  #     type: adaptive
  #     snapshot_url: http://192.168.1.40/webcam/?action=snapshot
  #     active_fps: 2
  #     idle_fps: 0.25
  #     rotation: 90

  # Camera served over WebRTC (e.g. go2rtc / camera-streamer); the browser opens stream_url directly.
  # - id: anyprinter
  #   ...
  #   camera:
  #     type: webrtc
  #     stream_url: http://192.168.1.50:1984/stream.html?src=cam
  #     snapshot_url: http://192.168.1.50:1984/api/frame.jpeg?src=cam

  # Simulator example:
  # - id: ir3
  #   model_name: IdeaFormer
  #   custom_name: IdeaFormer IR3 V2
  #   icon: generic
  #   connection:
  #     type: simulated
  #     profile: ideaformer
  #     scenario: mixed
